<?xml version="1.0" encoding="utf-8"?>
<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="KBC.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png">

  <meta name="description" content="KUET Business and Entrepreneurship Club (KBEC) - Fostering innovation, entrepreneurship, and business excellence at Khulna University of Engineering & Technology.">
  <meta name="keywords" content="KBEC, KUET, Business Club, Entrepreneurship, Student Organization, Innovation, Leadership, KUET Business Club, Entrepreneurship Club, Khulna University, Business Events, Startup">
  <meta name="author" content="KUET Business and Entrepreneurship Club">
  <meta name="theme-color" content="#F1BF63">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow">

  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.kbec-official.org/">
  <meta property="og:title" content="KUET Business and Entrepreneurship Club (KBEC)">
  <meta property="og:description" content="Fostering innovation, entrepreneurship, and business excellence at Khulna University of Engineering & Technology.">
  <meta property="og:site_name" content="KBEC">
  <meta property="og:image" content="https://www.kbec-official.org/favicon.png">
  <meta property="og:locale" content="en_US">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="KUET Business and Entrepreneurship Club (KBEC)">
  <meta name="twitter:description" content="Fostering innovation, entrepreneurship, and business excellence.">

  <link rel="canonical" href="https://www.kbec-official.org/">
  <link rel="manifest" href="/site.webmanifest">

  <title>
    <asp:ContentPlaceHolder ID="TitleContent" runat="server">KUET Business and Entrepreneurship Club (KBEC)</asp:ContentPlaceHolder>
  </title>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "KUET Business and Entrepreneurship Club",
    "alternateName": "KBEC",
    "url": "https://www.kbec-official.org",
    "logo": "https://www.kbec-official.org/favicon.png",
    "description": "Fostering innovation, entrepreneurship, and business excellence at Khulna University of Engineering & Technology.",
    "foundingLocation": {
      "@type": "Place",
      "name": "Khulna University of Engineering & Technology",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Khulna",
        "addressCountry": "BD"
      }
    },
    "sameAs": []
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "KBEC",
    "url": "https://www.kbec-official.org"
  }
  </script>

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XV48JD2VG5"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XV48JD2VG5');
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500;700;800;900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="index.css">
  <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
  <form id="form1" runat="server">
    <!-- Background Animated Shapes -->
    <div class="bg-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>

    <!-- Header Navigation -->
    <header class="site-header">
      <div class="container header-inner">
        <div class="brand">
          <a href="index.aspx" style="display: flex; align-items: center; gap: 12px; text-decoration: none;">
            <img src="logo.png" alt="KBC Logo" style="height: 40px; width: auto;">
            <div class="brand-text">
              <span>KBC</span>
              <p>KUET Business & Entrepreneurship Club</p>
            </div>
          </a>
        </div>
        <nav class="nav-links">
          <a href="index.aspx">Home</a>
          <a href="index.aspx#about">About</a>
          <a href="member.aspx">Members</a>
          <a href="events.aspx">Events</a>
          <a href="index.aspx#vision">Vision</a>
          <a href="admin-login.aspx" class="nav-cta">Admin</a>
        </nav>
      </div>
    </header>

    <!-- Main Content Area -->
    <main>
      <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container footer-inner">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; margin-bottom: 30px;">
          <div>
            <h3 style="margin-bottom: 15px;">About KBEC</h3>
            <p style="color: #94a3b8; font-size: 14px; line-height: 1.6;">
              KUET Business & Entrepreneurship Club is dedicated to fostering innovation, entrepreneurship, and business excellence among students.
            </p>
          </div>
          <div>
            <h3 style="margin-bottom: 15px;">Quick Links</h3>
            <ul style="list-style: none; padding: 0;">
              <li style="margin-bottom: 8px;"><a href="index.aspx" style="color: #94a3b8; text-decoration: none; transition: color 0.3s;">Home</a></li>
              <li style="margin-bottom: 8px;"><a href="events.aspx" style="color: #94a3b8; text-decoration: none; transition: color 0.3s;">Events</a></li>
              <li style="margin-bottom: 8px;"><a href="member.aspx" style="color: #94a3b8; text-decoration: none; transition: color 0.3s;">Members</a></li>
              <li><a href="admin-login.aspx" style="color: #94a3b8; text-decoration: none; transition: color 0.3s;">Admin Panel</a></li>
            </ul>
          </div>
          <div>
            <h3 style="margin-bottom: 15px;">Contact</h3>
            <p style="color: #94a3b8; font-size: 14px; margin-bottom: 8px;"><strong>Email:</strong> info@kbcofficial.com</p>
            <p style="color: #94a3b8; font-size: 14px; margin-bottom: 8px;"><strong>Location:</strong> KUET Campus, Khulna</p>
            <p style="color: #94a3b8; font-size: 14px;"><strong>Phone:</strong> Contact us for more info</p>
          </div>
        </div>
        <hr style="border: none; border-top: 1px solid rgba(255, 255, 255, 0.1); margin-bottom: 20px;">
        <div style="text-align: center;">
          <p style="color: #94a3b8; font-size: 14px;">&copy; 2026 KUET Business &amp; Entrepreneurship Club. All rights reserved.</p>
          <p style="color: #94a3b8; font-size: 12px; margin-top: 10px;">Designed with &hearts; for the KUET Community</p>
        </div>
      </div>
    </footer>

    <script src="script.js"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server"></asp:ContentPlaceHolder>
  </form>
</body>
</html>
